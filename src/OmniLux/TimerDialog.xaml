<Window x:Class="OmniLux.TimerDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Brightness timer" Style="{StaticResource {x:Type Window}}" Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/OmniLux.ico">
 <StackPanel Margin="25,22,25,24">
  <TextBlock x:Name="HeadingText" Text="Add brightness timer" FontSize="21" FontWeight="Medium" Margin="0,0,0,20" />
  <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,7" />
  <TextBox x:Name="NameBox" MaxLength="60" Text="Brightness timer" TextChanged="Field_TextChanged" AutomationProperties.Name="Timer name" Margin="0,0,0,16" />
  <TextBlock Text="Display" Style="{StaticResource Caption}" Margin="0,0,0,7" />
  <ComboBox x:Name="TargetPicker" DisplayMemberPath="Name" AutomationProperties.Name="Target display" Margin="0,0,0,16" />
  <TextBlock Text="When" Style="{StaticResource Caption}" Margin="0,0,0,7" />
  <ComboBox x:Name="KindPicker" SelectionChanged="Kind_SelectionChanged" AutomationProperties.Name="Timer type" Margin="0,0,0,14"><ComboBoxItem Content="After a countdown" /><ComboBoxItem Content="Every day" /></ComboBox>
  <Grid x:Name="CountdownFields" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="MinutesBox" Text="30" MaxLength="5" TextChanged="Field_TextChanged" AutomationProperties.Name="Countdown minutes" /><TextBlock Grid.Column="1" Text="minutes from now" Style="{StaticResource Caption}" Margin="12,0,0,0" /></Grid>
  <Grid x:Name="DailyFields" Visibility="Collapsed" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="TimeBox" Text="20:00" MaxLength="5" TextChanged="Field_TextChanged" AutomationProperties.Name="Daily time in 24 hour format" /><TextBlock Grid.Column="1" Text="local time · HH:mm" Style="{StaticResource Caption}" Margin="12,0,0,0" /></Grid>
  <Grid><TextBlock Text="Brightness" Style="{StaticResource Caption}" /><TextBlock x:Name="PercentText" Text="40%" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="16" /></Grid>
  <Slider x:Name="BrightnessSlider" Value="40" ValueChanged="Brightness_ValueChanged" AutomationProperties.Name="Timer brightness" Margin="0,8,0,10" />
  <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Margin="0,0,9,0" /><Button x:Name="SaveTimerButton" Content="Save timer" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click" /></StackPanel>
 </StackPanel>
</Window>
