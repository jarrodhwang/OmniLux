<Window x:Class="OmniLux.QuickControlsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="OmniLux quick controls" Style="{StaticResource {x:Type Window}}" Width="390" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
 Deactivated="Window_Deactivated" PreviewKeyDown="Window_KeyDown" SourceInitialized="Window_SourceInitialized">
 <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="15,13">
  <StackPanel>
   <Grid Margin="2,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Image Source="Assets/OmniLux.ico" Width="21" Height="21" Margin="0,0,8,0" /><TextBlock Text="OmniLux" FontWeight="Medium" FontSize="14" /></StackPanel>
    <Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" Padding="8,5" AutomationProperties.Name="Refresh monitors" ToolTip="Refresh monitors"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="15" /></Button>
    <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="OpenMain_Click" Padding="8,5" AutomationProperties.Name="Open OmniLux main window" ToolTip="Open OmniLux"><TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="15" /></Button>
   </Grid>
   <ScrollViewer x:Name="MonitorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="550">
    <StackPanel Margin="0,0,3,0">
     <ItemsControl x:Name="MonitorItems" ItemsSource="{Binding Monitors}" IsEnabled="{Binding CanRefresh}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"><StackPanel>
       <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Connection}" Style="{StaticResource Caption}" FontSize="10" Margin="0,3,0,0" />
       <ContentControl Content="{Binding Brightness}" ContentTemplate="{StaticResource MonitorSettingTemplate}" />
       <ContentControl Content="{Binding Contrast}" ContentTemplate="{StaticResource MonitorSettingTemplate}" />
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="No monitors connected" Style="{StaticResource Caption}" Margin="10" Visibility="{Binding HasNoMonitors, Converter={StaticResource BoolVisibility}}" />
     <Expander Header="All adjustable displays" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,5" Visibility="{Binding HasAdjustable, Converter={StaticResource BoolVisibility}}">
      <StackPanel Margin="8,0,8,8"><ContentControl Content="{Binding AllBrightness}" ContentTemplate="{StaticResource MonitorSettingTemplate}" /><ContentControl Content="{Binding AllContrast}" ContentTemplate="{StaticResource MonitorSettingTemplate}" Visibility="{Binding AllContrast.IsAvailable, Converter={StaticResource BoolVisibility}}" /></StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <Grid Margin="2,11,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" /><TextBlock Grid.Column="1" Text="{Binding TimerSummary}" Style="{StaticResource Caption}" FontSize="10" Margin="10,0,0,0" /></Grid>
  </StackPanel>
 </Border>
</Window>
